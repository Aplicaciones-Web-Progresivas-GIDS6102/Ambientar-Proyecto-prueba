{
  "info": {
    "name": "GestoPago - Pagos de Servicios y 2FA",
    "description": "Colección completa para probar el flujo de pagos de servicios con GestoPago y segunda autenticación (2FA) vía Brevo. Incluye casos de éxito y pruebas de validación/error.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "jwt", "value": "" },
    { "key": "numCuenta", "value": "4000123456" },
    { "key": "codigo2FA", "value": "123456" },
    { "key": "ultimoUpc", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }]
  },
  "item": [
    {
      "name": "1. Iniciar Sesión (Login - Obtener JWT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "if (r.token) {",
              "    pm.collectionVariables.set('jwt', r.token);",
              "    console.log('JWT guardado exitosamente en la colección');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "description": "Autentica al usuario 'lizet' con contraseña 'Password123!'. Guarda automáticamente el token JWT para los siguientes endpoints.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"lizet\",\n  \"password\": \"Password123!\"\n}"
        }
      }
    },
    {
      "name": "2. Consultar Catálogo de Productos (Público)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/gestopago/productos",
        "description": "Endpoint público para consultar el catálogo sincronizado de servicios y productos de GestoPago."
      }
    },
    {
      "name": "3. Consultar Saldo Actual de la Cuenta",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/cuentas/{{numCuenta}}/saldo",
        "description": "Verifica el saldo antes de pagar. El cliente de prueba inicia con $2,500.00 MXN."
      }
    },
    {
      "name": "4. Solicitar Código 2FA para Pago (Envía correo a rmm.che@gmail.com)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/gestopago/pagos/solicitar-2fa",
        "description": "Valida saldo, cuenta y producto. Genera un código OTP de 6 dígitos con vigencia de 5 minutos y lo envía al correo rmm.che@gmail.com a través de Brevo.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numCuenta\": \"{{numCuenta}}\",\n  \"idServicio\": \"2284\",\n  \"idProducto\": \"14302\",\n  \"monto\": 100.00,\n  \"telefono\": \"4771234567\"\n}"
        }
      }
    },
    {
      "name": "5. Pagar Servicio con Código 2FA",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "if (r.data && r.data.upc) {",
              "    pm.collectionVariables.set('ultimoUpc', r.data.upc);",
              "    console.log('UPC guardado:', r.data.upc);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/gestopago/pagos",
        "description": "Ejecuta el pago. IMPORTANTE: Reemplaza '123456' en la variable {{codigo2FA}} o en el body con el código recibido en tu correo rmm.che@gmail.com.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numCuenta\": \"{{numCuenta}}\",\n  \"idServicio\": \"2284\",\n  \"idProducto\": \"14302\",\n  \"monto\": 100.00,\n  \"telefono\": \"4771234567\",\n  \"codigo2FA\": \"{{codigo2FA}}\"\n}"
        }
      }
    },
    {
      "name": "6. Consultar Saldo Posterior (Verificar Descuento)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/cuentas/{{numCuenta}}/saldo",
        "description": "Verifica que el saldo se haya descontado únicamente tras el pago exitoso (debe reflejar $2,400.00 MXN)."
      }
    },
    {
      "name": "7. Conciliar Transacción Pendiente (confirmTx.do)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/gestopago/pagos/confirmar/{{ultimoUpc}}",
        "description": "Consulta el estado en GestoPago para transacciones pendientes y aplica el débito si fue confirmada (Applied)."
      }
    },
    {
      "name": "8. Error 401 - Código 2FA Incorrecto",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/gestopago/pagos",
        "description": "Verifica el rechazo cuando se envía un código OTP incorrecto (incrementa intentos fallidos).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numCuenta\": \"{{numCuenta}}\",\n  \"idServicio\": \"2284\",\n  \"idProducto\": \"14302\",\n  \"monto\": 100.00,\n  \"telefono\": \"4771234567\",\n  \"codigo2FA\": \"999999\"\n}"
        }
      }
    },
    {
      "name": "9. Error 400 - Saldo Insuficiente",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/gestopago/pagos",
        "description": "Verifica el rechazo inmediato cuando el monto excede el saldo disponible de la cuenta.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numCuenta\": \"{{numCuenta}}\",\n  \"idServicio\": \"2284\",\n  \"idProducto\": \"14302\",\n  \"monto\": 99999.00,\n  \"telefono\": \"4771234567\",\n  \"codigo2FA\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "10. Error 400 - Producto Inexistente en Catálogo",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/gestopago/pagos",
        "description": "Verifica que no se permita pagar productos que no existan en el catálogo oficial de GestoPago.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numCuenta\": \"{{numCuenta}}\",\n  \"idServicio\": \"2284\",\n  \"idProducto\": \"00000\",\n  \"monto\": 100.00,\n  \"telefono\": \"4771234567\",\n  \"codigo2FA\": \"123456\"\n}"
        }
      }
    }
  ]
}
